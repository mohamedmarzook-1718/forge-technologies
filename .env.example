# ==============================================================================
# RESEND EMAIL DELIVERY CONFIGURATION (Vercel & Localhost)
# ==============================================================================
# 1. RESEND_API_KEY (Required):
#    Get your API key from https://resend.com/api-keys (starts with "re_...")
#    Add this in Vercel: Project Settings -> Environment Variables -> RESEND_API_KEY
#    Add this locally in: .env.local
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# 2. FROM_EMAIL (Optional - defaults to "Forge Technologies <onboarding@resend.dev>"):
#    - For initial sandbox testing (before domain verification):
#      FROM_EMAIL="Forge Technologies <onboarding@resend.dev>"
#    - For production (after adding & verifying your domain in Resend):
#      FROM_EMAIL="Forge Technologies <notifications@yourdomain.com>"
FROM_EMAIL="Forge Technologies <onboarding@resend.dev>"

# 3. TO_EMAIL (Optional - defaults to "contact.forgetechnologies@gmail.com"):
#    The primary recipient inbox where client project briefs and inquiries will be delivered.
TO_EMAIL="contact.forgetechnologies@gmail.com"

# ==============================================================================
# STUDIO CONFIGURATION
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini AI API features if utilized.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The canonical URL where this application is hosted.
APP_URL="https://forgetechnologies.vercel.app"
